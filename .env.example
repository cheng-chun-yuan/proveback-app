PORT=4000
# 對外網址。接 Self 時必須是公開 HTTPS(ngrok / Cloudflare Tunnel)
PUBLIC_URL=http://localhost:4000
# proveback-bot 的位址,以及兩邊共用的密鑰(兩個 repo 要填一樣)
BOT_URL=http://localhost:4100
SHARED_SECRET=change-me
# 管理後台密碼(帳號任意)。留空 = 不上鎖,只適合本機
ADMIN_PASSWORD=

# --- Self(留空 = 示範模式,用假資料驗證)---
# 測試金鑰 sk_test_… 可用 Self app 的 mock 護照
SELF_API_KEY=
SELF_WEBHOOK_SECRET=
# 預設 flow;政策上也可以各自指定
SELF_FLOW_ID=
