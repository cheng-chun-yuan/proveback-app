PORT=8787
# 前端網址。前端 dev server 會把 /api 代理到這個後端,所以 cookie 是同源的
WEB_URL=http://localhost:5173
# 後端對外網址,給 Recall / Self 的 webhook 用。接真實服務時必須是公開 HTTPS(ngrok / Cloudflare Tunnel)
PUBLIC_API_URL=http://localhost:8787
# 用來衍生 nullifier 雜湊的金鑰。正式使用一定要設定且不能更換,否則回訪的來賓認不出來
SESSION_SECRET=
# 資料庫檔案,預設 apps/api/data/proveback.sqlite
# DB_PATH=

# --- Google OAuth(主辦方登入)。留空 = 假登入 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 預設 <WEB_URL>/api/v1/auth/google/callback,要跟 Google Cloud Console 填的一致
# GOOGLE_REDIRECT_URI=

# --- Recall.ai(bot 進 Google Meet)。留空 = 用 dev 端點模擬參與者 ---
RECALL_API_KEY=
# us-east-1 / us-west-2 / eu-central-1 / ap-northeast-1,要跟 Recall 帳號區域一致
RECALL_REGION=us-west-2
# webhook 網址上帶的 token,隨便一串亂數。沒設定的話所有 Recall webhook 都會被拒絕
RECALL_WEBHOOK_TOKEN=
BOT_NAME=ProveBack

# --- Self(護照證明,off-chain)。留空 = 用前端的 /dev/self 頁模擬 ---
# 測試金鑰 sk_test_… 可用 Self app 產生的 mock 護照
SELF_API_KEY=
SELF_WEBHOOK_SECRET=
SELF_FLOW_ID=

# --- Self 開源 SDK(舊版,不需要金鑰)。SELF_API_KEY 留空並設 SELF_MODE=open 才會啟用 ---
# Self app 會把證明直接送到 <PUBLIC_API_URL>/webhooks/self-proof,所以 PUBLIC_API_URL 必須是公開 HTTPS
# SELF_MODE=open
# 前後端共用的 scope(30 字元以內)
# SELF_SCOPE=proveback
# true = 接受 Self app 產生的 mock 護照(staging);真實護照設 false
# SELF_MOCK=true
